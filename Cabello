<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Cabello — Smooth. Sleek. Simple.</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600;700&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,600&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --cream:#F8F9FA;
  --cream-2:#F1EDE7;
  --charcoal:#1A1A1A;
  --charcoal-soft:#3A3A3A;
  --sage:#A9CDB0;
  --sage-deep:#6E9C79;
  --sage-ink:#2E4535;
  --blush:#FAD0C4;
  --blush-deep:#E39C88;
  --blush-ink:#5A362D;
  --line:rgba(26,26,26,.12);
  --script:"Dancing Script",cursive;
  --serif:"Playfair Display",Georgia,"Times New Roman",serif;
  --sans:"Work Sans",-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
body{
  margin:0;background:var(--cream);color:var(--charcoal);font-family:var(--sans);
  font-size:17px;line-height:1.6;overflow-x:hidden;
}
img{max-width:100%}
a{color:inherit;text-decoration:none}
button{font-family:inherit}
:focus-visible{outline:2px solid var(--sage-deep);outline-offset:3px;border-radius:2px}
.wrap{width:100%;max-width:1180px;margin:0 auto;padding:0 28px}
.dim{color:var(--charcoal-soft)}

/* ---------- header ---------- */
header{position:sticky;top:0;z-index:50;background:rgba(248,249,250,.9);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.bar{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:16px 0}
.brand{display:flex;flex-direction:column;background:none;border:0;cursor:pointer;padding:0;text-align:left}
.logo{font-family:var(--script);font-size:34px;font-weight:700;color:var(--charcoal);line-height:1}
.tagline{font-size:11px;letter-spacing:.14em;color:var(--charcoal-soft);margin-top:2px}
nav.primary{display:flex;gap:4px}
.navlink{position:relative;padding:9px 16px;font-size:15px;color:var(--charcoal-soft);background:none;border:0;cursor:pointer;border-radius:999px;transition:.16s}
.navlink:hover{color:var(--charcoal)}
.navlink[aria-current="page"]{color:var(--charcoal);background:var(--sage)}
.bag{display:flex;align-items:center;gap:14px}
.cta{padding:11px 22px;border-radius:999px;background:var(--charcoal);color:var(--cream);font-weight:600;font-size:14.5px;border:0;cursor:pointer}
.cta:hover{background:var(--sage-ink)}
.burger{display:none;background:none;border:0;color:var(--charcoal);cursor:pointer;padding:6px;width:38px;height:38px}
.burger span,.burger::before,.burger::after{content:"";display:block;height:2px;background:currentColor;border-radius:2px;transition:transform .2s ease,opacity .2s ease}
.burger span{margin:7px 0}
.burger.open span{opacity:0}
.burger.open::before{transform:translateY(9px) rotate(45deg)}
.burger.open::after{transform:translateY(-9px) rotate(-45deg)}
.mobile-nav{display:none;flex-direction:column;gap:2px;padding:6px 28px 18px;border-top:1px solid var(--line)}
.mobile-nav .navlink{text-align:left;border-radius:10px;width:100%}
.mobile-nav.open{display:flex}

/* ---------- page switching ---------- */
.page{display:none}
.page.active{display:block;animation:fade .4s ease}
@keyframes fade{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
@media (prefers-reduced-motion:reduce){.page.active{animation:none}}

.section{padding:80px 0}
.section+.section{border-top:1px solid var(--line)}
.head{max-width:56ch}
.eyebrow{font-family:var(--serif);font-style:italic;font-size:18px;color:var(--sage-ink);margin:0 0 12px}
h1{font-family:var(--serif);font-weight:700;font-size:clamp(34px,5vw,58px);line-height:1.06;letter-spacing:-.01em;margin:0 0 18px}
h2{font-family:var(--serif);font-weight:700;font-size:clamp(28px,3.6vw,42px);line-height:1.1;margin:0 0 16px}
h3{font-family:var(--serif);font-weight:700;font-size:23px;margin:0 0 8px}
.lede{max-width:48ch;color:var(--charcoal-soft)}
.row{display:flex;gap:14px;flex-wrap:wrap;align-items:center}
.btn{display:inline-block;border:0;cursor:pointer;font-size:16px;font-weight:600;padding:15px 30px;border-radius:999px;background:var(--charcoal);color:var(--cream);transition:background .18s ease,transform .18s ease}
.btn:hover{background:var(--sage-ink);transform:translateY(-1px)}
.btn.ghost{background:transparent;color:var(--charcoal);border:1.5px solid var(--charcoal);padding:14px 28px}
.btn.ghost:hover{background:rgba(26,26,26,.06)}
.btn.sage{background:var(--sage-deep);color:#0E2214}
.btn.sage:hover{background:var(--sage-ink);color:var(--cream)}
.btn.blush{background:var(--blush-deep);color:#3A1B12}
.btn.blush:hover{background:var(--blush-ink);color:var(--cream)}

/* ---------- vessels ---------- */
.stage{position:relative;display:flex;align-items:flex-end;justify-content:center;gap:34px}
.stage::after{content:"";position:absolute;bottom:18px;left:8%;right:8%;height:26px;background:radial-gradient(ellipse at center,rgba(26,26,26,.16),rgba(26,26,26,0) 72%)}
.vessel{position:relative;z-index:2}
.bottle{width:118px}
.bottle .cap{width:50px;height:28px;margin:0 auto -6px;border-radius:8px 8px 4px 4px;background:linear-gradient(100deg,var(--sage-ink),var(--sage-deep) 55%,var(--sage-ink))}
.bottle .body{height:246px;border-radius:16px 16px 22px 22px;background:linear-gradient(105deg,var(--sage-deep) 0%,var(--sage) 42%,#D3E8D7 58%,var(--sage) 74%,var(--sage-ink) 100%);box-shadow:inset 0 -22px 34px rgba(26,26,26,.14);position:relative;overflow:hidden}
.tube{width:106px}
.tube .cap{width:62px;height:20px;margin:0 auto -4px;border-radius:5px;background:linear-gradient(100deg,var(--blush-ink),var(--blush-deep) 55%,var(--blush-ink))}
.tube .body{height:210px;border-radius:10px 10px 26px 26px;background:linear-gradient(105deg,var(--blush-deep) 0%,var(--blush) 42%,#FFE8DF 58%,var(--blush) 74%,var(--blush-ink) 100%);box-shadow:inset 0 -20px 30px rgba(26,26,26,.12);position:relative;overflow:hidden}
.serum{width:70px}
.serum .cap{width:34px;height:22px;margin:0 auto -4px;border-radius:4px 4px 2px 2px;background:linear-gradient(100deg,#8a7350,#c7ab77 55%,#8a7350)}
.serum .body{height:150px;border-radius:14px;background:linear-gradient(105deg,#c7ab77 0%,#e8d7b0 45%,#fff4e0 55%,#e8d7b0 65%,#8a7350 100%);box-shadow:inset 0 -16px 24px rgba(26,26,26,.12);position:relative;overflow:hidden}
.label{position:absolute;inset:auto 0 0;padding:12px 10px 16px;background:linear-gradient(0deg,rgba(255,255,255,.92),rgba(255,255,255,.55) 70%,rgba(255,255,255,0));text-align:center}
.label .nm{font-family:var(--serif);font-size:16px;font-weight:700;line-height:1;color:var(--charcoal)}
.label .sub{font-size:8px;letter-spacing:.16em;color:var(--charcoal-soft);margin-top:5px;text-transform:uppercase}
.gloss{position:absolute;top:0;left:16%;width:10px;height:100%;background:linear-gradient(180deg,rgba(255,255,255,.75),rgba(255,255,255,.1));filter:blur(2px)}

/* ---------- Home ---------- */
.home-hero{position:relative;padding:56px 0 84px;overflow:hidden;text-align:center}
.home-hero .stage{margin:0 auto;height:280px}
.hero-word{font-family:var(--serif);font-weight:800;font-size:clamp(64px,14vw,180px);letter-spacing:.02em;color:var(--charcoal);line-height:.9;margin:26px 0 8px}
.hero-sub{font-family:var(--serif);font-style:italic;font-size:clamp(18px,2.2vw,24px);color:var(--sage-ink);margin:0 0 30px}
.badges{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);margin-top:0}
.badge{background:var(--cream);padding:30px 22px;text-align:center}
.badge .ic{font-size:26px;margin-bottom:10px}
.badge .tx{font-weight:600;font-size:15px}
.teaser{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center}
.teaser .stage{height:280px}

/* ---------- About ---------- */
.story-quote{font-family:var(--serif);font-style:italic;font-size:clamp(20px,2.6vw,28px);line-height:1.5;max-width:62ch;color:var(--charcoal-soft);border-left:3px solid var(--sage-deep);padding-left:26px;margin:0}
.pillars{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--line);margin-top:40px}
.pillar{background:var(--cream);padding:34px 30px}
.pillar .num{font-family:var(--serif);font-size:15px;color:var(--sage-ink);margin-bottom:10px}
.pillar p{margin:0;color:var(--charcoal-soft);font-size:15.5px}

/* ---------- Products ---------- */
.filters{display:flex;gap:10px;margin:30px 0 6px;flex-wrap:wrap}
.chip{padding:9px 18px;border-radius:999px;border:1.5px solid var(--line);background:transparent;color:var(--charcoal-soft);font-size:14.5px;cursor:pointer}
.chip[aria-pressed="true"]{background:var(--charcoal);color:var(--cream);border-color:var(--charcoal)}
.product{display:grid;grid-template-columns:280px 1fr;gap:44px;padding:44px;border-radius:22px;margin-top:28px;border:1px solid var(--line)}
.product.sage-bg{background:linear-gradient(180deg,#F1F7F2,var(--cream) 55%)}
.product.blush-bg{background:linear-gradient(180deg,#FFF3EF,var(--cream) 55%)}
.product.neutral-bg{background:linear-gradient(180deg,#FBF6EC,var(--cream) 55%)}
.product.hide{display:none}
.product .stage{height:300px}
.subtitle-line{font-family:var(--serif);font-style:italic;color:var(--charcoal-soft);margin:2px 0 14px;font-size:15.5px}
.meta-row{display:flex;gap:18px;flex-wrap:wrap;font-size:13.5px;color:var(--charcoal-soft);margin-bottom:18px}
.meta-row b{color:var(--charcoal);font-weight:600}
.pcopy{max-width:56ch;color:var(--charcoal-soft);margin:0 0 22px}
.kv{display:grid;gap:16px;margin-bottom:8px}
.kv .row-item{display:grid;grid-template-columns:130px 1fr;gap:16px}
.kv .k{font-weight:700;font-size:12.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--charcoal-soft);padding-top:2px}
.kv .v{color:var(--charcoal-soft);font-size:15px}
.kv .v.small{font-size:13.5px;line-height:1.7}
.badges-row{display:flex;gap:8px;flex-wrap:wrap;margin:18px 0}
.pill{font-size:12px;letter-spacing:.04em;padding:6px 13px;border-radius:999px;border:1px solid var(--charcoal);color:var(--charcoal)}
.mfg{margin-top:18px;padding-top:16px;border-top:1px dashed var(--line);font-size:12.5px;color:var(--charcoal-soft);display:flex;gap:18px;flex-wrap:wrap}
.ext-tag{display:inline-block;font-size:11.5px;letter-spacing:.1em;text-transform:uppercase;background:var(--charcoal);color:var(--cream);padding:5px 12px;border-radius:6px;margin-bottom:14px}
.benefits{display:flex;gap:10px;flex-wrap:wrap;margin:0 0 18px}
.benefits span{font-size:13px;font-weight:600;padding:7px 14px;border-radius:999px;background:rgba(26,26,26,.06)}

.hype-row{display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin:20px 0 4px}
.hype-btn{display:inline-flex;align-items:center;gap:8px;border:1.5px solid var(--charcoal);background:transparent;color:var(--charcoal);font-weight:600;font-size:14.5px;padding:11px 20px;border-radius:999px;cursor:pointer;transition:background .16s ease,color .16s ease,transform .16s ease}
.hype-btn:hover:not(:disabled){transform:translateY(-1px)}
.hype-btn:disabled{cursor:default}
.product.sage-bg .hype-btn.hyped{background:var(--sage-deep);border-color:var(--sage-deep);color:#0E2214}
.product.blush-bg .hype-btn.hyped{background:var(--blush-deep);border-color:var(--blush-deep);color:#3A1B12}
.product.neutral-bg .hype-btn.hyped{background:#c7ab77;border-color:#c7ab77;color:#2A2010}
.hype-count{font-size:14px;color:var(--charcoal-soft)}
.hype-count strong{color:var(--charcoal);font-family:var(--serif);font-size:16px}

/* ---------- Brand Guide ---------- */
.type-table{display:grid;gap:0;margin-top:30px;border-top:1px solid var(--line)}
.type-row{display:grid;grid-template-columns:220px 1fr;gap:24px;padding:26px 0;border-bottom:1px solid var(--line);align-items:center}
.type-row .role{font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:var(--charcoal-soft)}
.type-row .sample.script{font-family:var(--script);font-size:32px}
.type-row .sample.serif{font-family:var(--serif);font-weight:700;font-size:26px}
.type-row .sample.sans{font-family:var(--sans);font-weight:700;font-size:14px;letter-spacing:.1em;text-transform:uppercase;color:var(--charcoal-soft)}
.palette{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin-top:34px}
.swatch{border-radius:16px;overflow:hidden;border:1px solid var(--line)}
.swatch .fill{height:110px}
.swatch .meta{padding:14px 16px;background:var(--cream)}
.swatch .meta b{display:block;font-size:14.5px;margin-bottom:2px}
.swatch .meta span{font-size:12.5px;color:var(--charcoal-soft);font-family:monospace}
.disclaimer{margin-top:48px;padding:28px 30px;border:1px dashed var(--charcoal-soft);border-radius:16px;background:var(--cream-2)}
.disclaimer p{margin:0;font-style:italic;color:var(--charcoal-soft);font-size:15px;line-height:1.7}

/* ---------- accordion ---------- */
.acc{border-top:1px solid var(--line);margin-top:38px}
.acc-item{border-bottom:1px solid var(--line)}
.acc-btn{width:100%;display:flex;justify-content:space-between;align-items:center;gap:16px;background:none;border:0;color:var(--charcoal);text-align:left;padding:22px 0;cursor:pointer;font-size:16px;font-weight:600}
.acc-btn .plus{font-family:var(--serif);font-size:22px;color:var(--sage-ink);transition:transform .2s ease}
.acc-btn[aria-expanded="true"] .plus{transform:rotate(45deg)}
.acc-panel{max-height:0;overflow:hidden;transition:max-height .25s ease}
.acc-panel p{padding:0 0 22px;color:var(--charcoal-soft);max-width:64ch;font-size:14.5px;line-height:1.75}

/* ---------- footer ---------- */
footer{padding:52px 0 40px;border-top:1px solid var(--line);color:var(--charcoal-soft);font-size:15px}
.fgrid{display:flex;justify-content:space-between;gap:32px;flex-wrap:wrap}
.fcol{display:grid;gap:9px}
.fcol b{color:var(--charcoal);font-weight:600;font-size:14px;margin-bottom:4px}
.fcol button{background:none;border:0;color:inherit;font-size:inherit;padding:0;text-align:left;cursor:pointer}
.fine{margin-top:34px;padding-top:20px;border-top:1px solid var(--line);font-size:13px}

@media (max-width:900px){
  nav.primary,.cta{display:none}
  .burger{display:block}
  .teaser{grid-template-columns:1fr;gap:14px}
  .teaser .stage{order:-1;height:260px}
  .badges{grid-template-columns:repeat(2,1fr)}
  .pillars{grid-template-columns:1fr}
  .product{grid-template-columns:1fr;gap:20px;padding:30px}
  .product .stage{height:250px}
  .kv .row-item{grid-template-columns:1fr}
  .type-row{grid-template-columns:1fr;gap:8px}
  .palette{grid-template-columns:repeat(2,1fr)}
  .wrap{padding:0 20px}
  .section{padding:60px 0}
}
@media (max-width:520px){
  body{font-size:16px}
  .bottle{width:96px}.bottle .body{height:200px}
  .tube{width:88px}.tube .body{height:172px}
  .hero-word{font-size:clamp(48px,20vw,90px)}
}
</style>
</head>
<body>

<header>
  <div class="wrap bar">
    <button class="brand" data-nav="home">
      <span class="logo">Cabello</span>
      <span class="tagline">SMOOTH. SLEEK. SIMPLE.</span>
    </button>
    <nav class="primary" aria-label="Primary">
      <button class="navlink" data-nav="home" aria-current="page">Home</button>
      <button class="navlink" data-nav="about">About Us</button>
      <button class="navlink" data-nav="products">Products</button>
      <button class="navlink" data-nav="guide">Brand Guide</button>
    </nav>
    <div class="bag">
      <button class="cta" data-nav="products">Shop the Collection</button>
      <button class="burger" aria-label="Open menu" aria-expanded="false"><span></span></button>
    </div>
  </div>
  <nav class="mobile-nav" aria-label="Mobile">
    <button class="navlink" data-nav="home" aria-current="page">Home</button>
    <button class="navlink" data-nav="about">About Us</button>
    <button class="navlink" data-nav="products">Products</button>
    <button class="navlink" data-nav="guide">Brand Guide</button>
  </nav>
</header>

<main>

  <!-- ============ HOME ============ -->
  <div class="page active" id="page-home">
    <section class="home-hero">
      <div class="wrap">
        <p class="eyebrow">Cabello — Premium Hair Care Formulated Specifically for Straight Hair</p>
        <div class="hero-word">SMOOTH</div>
        <p class="hero-sub">For Maintaining Smoothness &amp; Reducing Frizz</p>
        <div class="row" style="justify-content:center;margin-bottom:44px">
          <button class="btn" data-nav="products">Shop the Collection</button>
          <button class="btn ghost" data-nav="guide">View Brand Guide</button>
        </div>
        <div class="stage">
          <div class="vessel bottle"><div class="cap"></div><div class="body"><div class="gloss"></div><div class="label"><div class="nm">Shampoo</div><div class="sub">Cucumber &amp; Green Tea</div></div></div></div>
          <div class="vessel tube"><div class="cap"></div><div class="body"><div class="gloss"></div><div class="label"><div class="nm">Conditioner</div><div class="sub">Rice Protein</div></div></div></div>
        </div>
      </div>
    </section>

    <section class="section" style="padding-top:0">
      <div class="wrap">
        <div class="badges">
          <div class="badge"><div class="ic">🌿</div><div class="tx">Sulfate Free</div></div>
          <div class="badge"><div class="ic">🐇</div><div class="tx">Cruelty Free</div></div>
          <div class="badge"><div class="ic">🌱</div><div class="tx">Vegan Friendly</div></div>
          <div class="badge"><div class="ic">♻️</div><div class="tx">100% Recyclable Packaging</div></div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap teaser">
        <div class="stage">
          <div class="vessel bottle"><div class="cap"></div><div class="body"><div class="gloss"></div><div class="label"><div class="nm">Shampoo</div><div class="sub">Cucumber &amp; Green Tea</div></div></div></div>
          <div class="vessel tube"><div class="cap"></div><div class="body"><div class="gloss"></div><div class="label"><div class="nm">Conditioner</div><div class="sub">Rice Protein</div></div></div></div>
        </div>
        <div>
          <h2>Formulated specifically for straight hair</h2>
          <p class="lede">Straight hair has very specific needs — humidity frizz, oily scalp build-up, a lack of natural shine. Most brands treat all hair types the same. Cabello was created to fix that.</p>
          <button class="btn ghost" style="margin-top:22px" data-nav="about">Read our story</button>
        </div>
      </div>
    </section>
  </div>

  <!-- ============ ABOUT US ============ -->
  <div class="page" id="page-about">
    <section class="section" style="padding-top:64px">
      <div class="wrap">
        <p class="eyebrow">Brand Story &amp; Mission</p>
        <h1>The Story Behind Cabello</h1>
        <blockquote class="story-quote">
          Straight hair has very specific needs—like dealing with humidity frizz, oily scalp build-up, and a lack of natural shine—yet most hair care brands treat all hair types the same. Cabello was created to fix that. We build lightweight, botanical-powered formulas that keep straight hair sleek, fresh, and manageable without weighing it down.
        </blockquote>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="head"><h2>Core Brand Pillars</h2></div>
        <div class="pillars">
          <div class="pillar"><div class="num">01</div><h3>Targeted Performance</h3><p>Specifically formulated for straight hair concerns — frizz, oil control, shine.</p></div>
          <div class="pillar"><div class="num">02</div><h3>Botanical Ingredients</h3><p>Powered by natural extracts like Cucumber Water, Green Tea, and Rice Protein.</p></div>
          <div class="pillar"><div class="num">03</div><h3>Clean &amp; Ethical</h3><p>100% Vegan, Cruelty-Free, and Sulfate-Free.</p></div>
          <div class="pillar"><div class="num">04</div><h3>Accessible Luxury</h3><p>Premium visual design paired with everyday usability.</p></div>
        </div>
      </div>
    </section>

    <section class="section" style="text-align:center">
      <div class="wrap">
        <h2 style="margin:0 auto 10px">See the collection built on these pillars</h2>
        <button class="btn" style="margin-top:14px" data-nav="products">View Products</button>
      </div>
    </section>
  </div>

  <!-- ============ PRODUCTS ============ -->
  <div class="page" id="page-products">
    <section class="section" style="padding-top:64px">
      <div class="wrap">
        <div class="head">
          <p class="eyebrow">Product Range</p>
          <h2>Two formulas, plus a finishing extension</h2>
          <p class="dim">Net volume 355 mL / 12 fl oz for the shampoo and conditioner; the Gloss Serum is a compact 50 mL leave-in extension.</p>
        </div>

        <div class="filters" role="group" aria-label="Filter products">
          <button class="chip" data-filter="all" aria-pressed="true">All products</button>
          <button class="chip" data-filter="shampoo" aria-pressed="false">Shampoo</button>
          <button class="chip" data-filter="conditioner" aria-pressed="false">Conditioner</button>
          <button class="chip" data-filter="serum" aria-pressed="false">Serum</button>
        </div>


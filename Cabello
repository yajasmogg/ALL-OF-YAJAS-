<script>
(function(){
  var pages = { home:document.getElementById('page-home'), about:document.getElementById('page-about'), products:document.getElementById('page-products'), guide:document.getElementById('page-guide') };
  var mobileNav = document.querySelector('.mobile-nav');
  var burger = document.querySelector('.burger');

  function setPage(name, push){
    if(!pages[name]) return;
    Object.keys(pages).forEach(function(k){ pages[k].classList.toggle('active', k===name); });
    document.querySelectorAll('.navlink').forEach(function(b){
      var match = b.getAttribute('data-nav') === name;
      if(match) b.setAttribute('aria-current','page'); else b.removeAttribute('aria-current');
    });
    if(push !== false) history.pushState({page:name}, '', '#'+name);
    window.scrollTo({top:0, behavior:'auto'});
    mobileNav.classList.remove('open');
    burger.classList.remove('open');
    burger.setAttribute('aria-expanded','false');
  }

  document.querySelectorAll('[data-nav]').forEach(function(b){
    b.addEventListener('click', function(){ setPage(b.getAttribute('data-nav')); });
  });

  burger.addEventListener('click', function(){
    var open = mobileNav.classList.toggle('open');
    burger.classList.toggle('open', open);
    burger.setAttribute('aria-expanded', open ? 'true':'false');
  });

  window.addEventListener('popstate', function(e){
    var name = (e.state && e.state.page) || location.hash.replace('#','') || 'home';
    setPage(name, false);
  });

  var initial = location.hash.replace('#','');
  if(pages[initial]) setPage(initial, false);

  var chips = document.querySelectorAll('.chip');
  var products = document.querySelectorAll('.product');
  chips.forEach(function(chip){
    chip.addEventListener('click', function(){
      chips.forEach(function(c){ c.setAttribute('aria-pressed', c===chip ? 'true':'false'); });
      var f = chip.getAttribute('data-filter');
      products.forEach(function(p){
        p.classList.toggle('hide', f!=='all' && p.getAttribute('data-cat')!==f);
      });
    });
  });

  document.querySelectorAll('.acc-btn').forEach(function(btn){
    btn.addEventListener('click', function(){
      var panel = btn.nextElementSibling;
      var open = btn.getAttribute('aria-expanded') === 'true';
      document.querySelectorAll('.acc-btn').forEach(function(b){
        b.setAttribute('aria-expanded','false');
        b.nextElementSibling.style.maxHeight = null;
      });
      if(!open){
        btn.setAttribute('aria-expanded','true');
        panel.style.maxHeight = panel.scrollHeight + 'px';
      }
    });
  });

  /* ---------- hype counters (persisted via the db capability) ---------- */
  (async function initHype(){
    var products = ['shampoo','conditioner','serum'];

    function setUnavailable(){
      products.forEach(function(key){
        var countEl = document.getElementById('hype-count-'+key);
        if(countEl) countEl.textContent = '—';
      });
    }

    if(typeof claude === 'undefined' || !claude.use){
      setUnavailable();
      return;
    }

    var db;
    try{
      db = await claude.use('db');
    }catch(e){
      db = null;
    }

    if(!db){
      setUnavailable();
      return;
    }

    products.forEach(function(key){
      var btn = document.getElementById('hype-btn-'+key);
      var countEl = document.getElementById('hype-count-'+key);
      if(!btn || !countEl) return;

      var col = db.collection('hype-'+key);

      col.onSnapshot(function(snap){
        countEl.textContent = snap.size;
      }, function(err){
        countEl.textContent = '—';
      });

      var storageKey = 'cabello-hyped-'+key;
      if(localStorage.getItem(storageKey)){
        btn.classList.add('hyped');
        btn.disabled = true;
        btn.textContent = "You're hyped 🔥";
      }

      btn.addEventListener('click', function(){
        if(btn.disabled) return;
        btn.disabled = true;
        col.add({ ts: Date.now() }).then(function(ref){
          try{ localStorage.setItem(storageKey, ref.id); }catch(e){}
          btn.classList.add('hyped');
          btn.textContent = "You're hyped 🔥";
        }).catch(function(e){
          btn.disabled = false;
        });
      });
    });
  })();
})();
</script>
